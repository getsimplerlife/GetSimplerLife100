# ── OAuth Provider Credentials ──────────────────────────────────────
# Set these environment variables to enable OAuth for each provider.
# Variable naming: OAUTH_<PROVIDER>_CLIENT_ID / OAUTH_<PROVIDER>_CLIENT_SECRET
# Provider names are uppercased with hyphens replaced by underscores.
#
# Examples:
#   HubSpot:     OAUTH_HUBSPOT_CLIENT_ID / OAUTH_HUBSPOT_CLIENT_SECRET
#   Salesforce:  OAUTH_SALESFORCE_CLIENT_ID / OAUTH_SALESFORCE_CLIENT_SECRET
#   QuickBooks:  OAUTH_QUICKBOOKS_CLIENT_ID / OAUTH_QUICKBOOKS_CLIENT_SECRET
#   Xero:        OAUTH_XERO_CLIENT_ID / OAUTH_XERO_CLIENT_SECRET
#   Slack:       OAUTH_SLACK_CLIENT_ID / OAUTH_SLACK_CLIENT_SECRET
#   Google:      OAUTH_GOOGLE_CLIENT_ID / OAUTH_GOOGLE_CLIENT_SECRET
#   Microsoft:   OAUTH_MICROSOFT_CLIENT_ID / OAUTH_MICROSOFT_CLIENT_SECRET

# ── CRM Providers ───────────────────────────────────────────────────
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=
OAUTH_SALESFORCE_CLIENT_ID=
OAUTH_SALESFORCE_CLIENT_SECRET=
OAUTH_PIPEDRIVE_CLIENT_ID=
OAUTH_PIPEDRIVE_CLIENT_SECRET=
OAUTH_ZOHO_CLIENT_ID=
OAUTH_ZOHO_CLIENT_SECRET=

# ── ERP / Accounting ────────────────────────────────────────────────
OAUTH_QUICKBOOKS_CLIENT_ID=
OAUTH_QUICKBOOKS_CLIENT_SECRET=
OAUTH_XERO_CLIENT_ID=
OAUTH_XERO_CLIENT_SECRET=
OAUTH_NETSUITE_CLIENT_ID=
OAUTH_NETSUITE_CLIENT_SECRET=

# ── Communication ───────────────────────────────────────────────────
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Google Workspace ────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

